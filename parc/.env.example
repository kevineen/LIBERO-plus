# マシン固有設定（git に載せない）
#   cp .env.example .env.local
#
# 優先順位（高い順）:
#   1. すでに export 済みのシェル環境変数
#   2. .env.local
#   3. .env
#   4. configs/paths.yaml
#   5. デフォルト

# 必須に近いもの（PC2 ではここを変える）
PARC_MACHINE_ID=pc2
PARC_EXPERIMENTS_DIR=/data/parc_experiments
PARC_DATA_DIR=/data/parc_data
HF_HOME=/data/huggingface

# 任意
# PARC_LIBERO_PLUS_ROOT=/home/kevin/Matsuo/robot/LIBERO-plus
# MUJOCO_GL=egl
# PARC_WEB_ALLOW_JOBS=1
# PARC_WEB_PORT=3030
# PARC_WEB_LAUNCHER=queue

# Google Drive sync（rclone remote 名）
# PARC_SYNC_ENABLED=1
# PARC_RCLONE_REMOTE=gdrive

# 通知
# PARC_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
